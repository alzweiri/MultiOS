<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:directBootAware="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_keyboard_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_keyboard_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultiOSKeyboard">

        <!-- System-Wide InputMethodService -->
        <service
            android:name=".MultiOsInputMethodService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Companion Setup & Design Customizer Activity -->
        <activity
            android:name=".KeyboardSettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
